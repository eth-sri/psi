def main(){
	(a,b)~c := (1,2,3,4);
	d~(e,f) := [1,2,3,4];
	[g,h] := [5,6];
	(_,i) := (7,8);
	j: ℝ := 3;
	x := array(3,1.5);
	(k,l,m) := x;
	return (a,b,c,d,e,f,g,h,i,j,k,l,m); // expected: δ(1)[a]·δ(1,2)[d]·δ(2)[b]·δ(3)[j]·δ(3)[r]·δ(3,4)[c]·δ(3/2)[k]·δ(3/2)[l]·δ(3/2)[m]·δ(4)[f]·δ(5)[g]·δ(6)[h]·δ(8)[i]
}
