// Benchmark 1. (Quite common in the literature)

def main(){
    cloudy := flip(1/2);
    rain := flip(if cloudy { 4/5 } else { 1/5 });
    sprinkler := flip(if cloudy { 1/10 } else { 1/2 });
    wet_roof := flip(7/10) && rain;
    wet_grass := flip(9/10) && rain || flip(9/10) && sprinkler;
    observe(wet_grass);
    return rain; // expected: (1/10+9/10·[rain=0])·(1000/2157+7000/6471·[rain=0]+7000/6471·[rain≠0])·(189/1000·δ(0)[rain]+81/1000·δ(1)[rain])+500/719·δ(1)[rain]
	// TODO: improve simplification
}
