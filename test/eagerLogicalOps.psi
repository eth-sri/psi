def main(){
	u := [flip(1/2), flip(1/2)];
	x := u[0] ∧ u[1];
	y := u[0] ∨ u[1];
	z := u[0] ⊻ u[1];
	w := false;
	w ∨= x;
	w ⊻= y;
	return (x,y,z,w); // expected: ((1/2·δ(1)[y]·δ(1)[z]+1/4·δ(0)[y]·δ(0)[z])·δ(0)[x]+1/4·δ(0)[z]·δ(1)[x]·δ(1)[y])·([x=0]·[y=0]·δ(0)[w]+[x=0]·[y≠0]·δ(1)[w]+[x≠0]·[y=0]·δ(1)[w]+[x≠0]·[y≠0]·δ(0)[w])
}
